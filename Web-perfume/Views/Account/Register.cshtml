@model Web_perfume.Models.RegisterViewModel
@{
    ViewBag.Title = "Đăng Ký Tài Khoản";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-sm-10">
            <div class="card border border-light-subtle rounded-0 bg-white p-4 p-md-5 shadow-none">
                <div class="text-center mb-4">
                    <span class="section-subtitle">AURA PARFUMS</span>
                    <h1 class="font-serif h3 mb-2">Đăng Ký Thành Viên</h1>
                    <p class="text-muted small">Trở thành thành viên để nhận ưu đãi đặc quyền và lưu trữ đơn hàng thuận tiện</p>
                </div>

                @using (Html.BeginForm("Register", "Account", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger small py-2" })

                    <div class="mb-3">
                        @Html.LabelFor(m => m.FullName, new { @class = "form-label small fw-semibold text-uppercase letter-spacing-1" })
                        @Html.TextBoxFor(m => m.FullName, new { @class = "form-control", placeholder = "Nguyễn Văn A" })
                        @Html.ValidationMessageFor(m => m.FullName, "", new { @class = "text-danger small" })
                    </div>

                    <div class="mb-3">
                        @Html.LabelFor(m => m.Email, new { @class = "form-label small fw-semibold text-uppercase letter-spacing-1" })
                        @Html.TextBoxFor(m => m.Email, new { @class = "form-control", placeholder = "email@example.com" })
                        @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small" })
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            @Html.LabelFor(m => m.Password, new { @class = "form-label small fw-semibold text-uppercase letter-spacing-1" })
                            @Html.PasswordFor(m => m.Password, new { @class = "form-control", placeholder = "Tối thiểu 6 ký tự" })
                            @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger small" })
                        </div>
                        <div class="col-md-6">
                            @Html.LabelFor(m => m.ConfirmPassword, new { @class = "form-label small fw-semibold text-uppercase letter-spacing-1" })
                            @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control", placeholder = "Nhập lại mật khẩu" })
                            @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger small" })
                        </div>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            @Html.LabelFor(m => m.Phone, new { @class = "form-label small fw-semibold text-uppercase letter-spacing-1" })
                            @Html.TextBoxFor(m => m.Phone, new { @class = "form-control", placeholder = "0987654321" })
                            @Html.ValidationMessageFor(m => m.Phone, "", new { @class = "text-danger small" })
                        </div>
                        <div class="col-md-6">
                            @Html.LabelFor(m => m.Address, new { @class = "form-label small fw-semibold text-uppercase letter-spacing-1" })
                            @Html.TextBoxFor(m => m.Address, new { @class = "form-control", placeholder = "Địa chỉ nhận hàng mặc định" })
                            @Html.ValidationMessageFor(m => m.Address, "", new { @class = "text-danger small" })
                        </div>
                    </div>

                    <button type="submit" class="btn btn-luxury-dark w-100 py-3 mb-3">
                        Tạo Tài Khoản
                    </button>

                    <div class="text-center small text-muted">
                        Đã có tài khoản? 
                        <a href="@Url.Action("Login", "Account")" class="fw-bold text-dark text-decoration-underline">
                            Đăng nhập
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

