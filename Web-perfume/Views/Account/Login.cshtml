@model Web_perfume.Models.LoginViewModel
@{
    ViewBag.Title = "Đăng Nhập";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-5 col-sm-8">
            <div class="card border border-light-subtle rounded-0 bg-white p-4 p-md-5 shadow-none">
                <div class="text-center mb-4">
                    <span class="section-subtitle">AURA PARFUMS</span>
                    <h1 class="font-serif h3 mb-2">Đăng Nhập Tài Khoản</h1>
                    <p class="text-muted small">Đăng nhập để theo dõi đơn hàng và tận hưởng ưu đãi thành viên</p>
                </div>

                @using (Html.BeginForm("Login", "Account", new { returnUrl = Model.ReturnUrl }, FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger small py-2" })

                    <div class="mb-3">
                        @Html.LabelFor(m => m.Email, new { @class = "form-label small fw-semibold text-uppercase letter-spacing-1" })
                        @Html.TextBoxFor(m => m.Email, new { @class = "form-control", placeholder = "admin@perfumeshop.vn hoặc email của bạn", autofocus = "autofocus" })
                        @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small" })
                    </div>

                    <div class="mb-3">
                        <div class="d-flex justify-content-between">
                            @Html.LabelFor(m => m.Password, "Mật khẩu", new { @class = "form-label small fw-semibold text-uppercase letter-spacing-1" })
                            <a href="#" class="small text-muted">Quên mật khẩu?</a>
                        </div>
                        @Html.PasswordFor(m => m.Password, new { @class = "form-control", placeholder = "••••••••" })
                        @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger small" })
                    </div>

                    <div class="mb-4 form-check">
                        @Html.CheckBoxFor(m => m.RememberMe, new { @class = "form-check-input" })
                        @Html.LabelFor(m => m.RememberMe, new { @class = "form-check-label small" })
                    </div>

                    <button type="submit" class="btn btn-luxury-dark w-100 py-3 mb-3">
                        Đăng Nhập
                    </button>

                    <div class="text-center small text-muted">
                        Chưa có tài khoản? 
                        <a href="@Url.Action("Register", "Account")" class="fw-bold text-dark text-decoration-underline">
                            Đăng ký ngay
                        </a>
                    </div>

                    <!-- Demo credentials box for professor / grader -->
                    <div class="mt-4 pt-3 border-top small text-muted bg-light p-2 rounded-1">
                        <div class="fw-bold text-dark mb-1"><i class="bi bi-info-circle me-1"></i>Tài khoản demo kiểm thử:</div>
                        <div>• Admin: <code>admin@perfumeshop.vn</code> / <code>admin123</code></div>
                        <div>• Customer: <code>minhanh@example.com</code> / <code>123456</code></div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

