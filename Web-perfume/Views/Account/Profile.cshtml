@model Web_perfume.Models.UserProfileViewModel
@{
    ViewBag.Title = "Tài Khoản Của Tôi";
}

<!-- Breadcrumbs -->
<div class="bg-light py-3 border-bottom">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 small">
                <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Trang chủ</a></li>
                <li class="breadcrumb-item active" aria-current="page">Tài khoản cá nhân</li>
            </ol>
        </nav>
    </div>
</div>

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
        <div>
            <h1 class="font-serif h3 mb-1">Tài Khoản Của Tôi</h1>
            <p class="text-muted small mb-0">Quản lý thông tin hồ sơ và theo dõi lịch sử đơn hàng</p>
        </div>
        <div>
            <a href="@Url.Action("Logout", "Account")" class="btn btn-outline-danger btn-sm">
                <i class="bi bi-box-arrow-right me-1"></i> Đăng xuất
            </a>
        </div>
    </div>

    @if (TempData["ProfileSuccess"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>@TempData["ProfileSuccess"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-4">
        <!-- Profile Info Form -->
        <div class="col-lg-4">
            <div class="card border border-light-subtle rounded-0 bg-white p-4 shadow-none">
                <h5 class="font-serif mb-3 pb-2 border-bottom">Thông Tin Cá Nhân</h5>

                @using (Html.BeginForm("UpdateProfile", "Account", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-uppercase letter-spacing-1">Email:</label>
                        <input type="text" class="form-control bg-light" value="@Model.User.Email" readonly disabled />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-uppercase letter-spacing-1">Họ và tên:</label>
                        <input type="text" name="fullName" class="form-control" value="@Model.User.FullName" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-uppercase letter-spacing-1">Số điện thoại:</label>
                        <input type="text" name="phone" class="form-control" value="@Model.User.Phone" />
                    </div>

                    <div class="mb-4">
                        <label class="form-label small fw-semibold text-uppercase letter-spacing-1">Địa chỉ mặc định:</label>
                        <textarea name="address" class="form-control" rows="2">@Model.User.Address</textarea>
                    </div>

                    <button type="submit" class="btn btn-luxury-dark w-100 py-2">
                        Lưu Thay Đổi
                    </button>
                }
            </div>
        </div>

        <!-- Orders History -->
        <div class="col-lg-8" id="orders">
            <div class="card border border-light-subtle rounded-0 bg-white p-4 shadow-none">
                <h5 class="font-serif mb-3 pb-2 border-bottom">Lịch Sử Đơn Hàng (@Model.Orders.Count)</h5>

                @if (Model.Orders.Any())
                {
                    <div class="table-responsive">
                        <table class="table align-middle small mb-0">
                            <thead class="bg-light text-uppercase">
                                <tr>
                                    <th>Mã đơn</th>
                                    <th>Ngày đặt</th>
                                    <th>Số món</th>
                                    <th>Tổng tiền</th>
                                    <th>Trạng thái</th>
                                    <th>Thanh toán</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var order in Model.Orders)
                                {
                                    <tr>
                                        <td>
                                            <strong class="text-dark">#@order.OrderCode</strong>
                                        </td>
                                        <td>@order.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td>@order.OrderItems.Count sản phẩm</td>
                                        <td class="fw-bold">@order.TotalAmount.ToString("N0") ₫</td>
                                        <td>
                                            @if (order.OrderStatus == "Delivered")
                                            {
                                                <span class="badge bg-success">Đã giao</span>
                                            }
                                            else if (order.OrderStatus == "Cancelled")
                                            {
                                                <span class="badge bg-danger">Đã hủy</span>
                                            }
                                            else if (order.OrderStatus == "Processing")
                                            {
                                                <span class="badge bg-info text-dark">Đang xử lý</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning text-dark">Chờ xác nhận</span>
                                            }
                                        </td>
                                        <td>
                                            <span class="badge bg-light text-dark border">
                                                @(order.PaymentMethod == "COD" ? "COD" : "Chuyển khoản")
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-4 text-muted">
                        <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                        <p class="mb-0">Bạn chưa có đơn hàng nào.</p>
                        <a href="@Url.Action("Index", "Products")" class="btn btn-luxury-dark mt-3">
                            Mua Sắm Ngay
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

