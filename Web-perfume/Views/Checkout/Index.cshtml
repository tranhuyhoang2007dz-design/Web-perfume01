@model Web_perfume.Models.CheckoutViewModel
@{
    ViewBag.Title = "Thanh Toán & Đặt Hàng";
}

<!-- Breadcrumbs -->
<div class="bg-light py-3 border-bottom">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 small">
                <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Trang chủ</a></li>
                <li class="breadcrumb-item"><a href="@Url.Action("Index", "Cart")">Giỏ hàng</a></li>
                <li class="breadcrumb-item active" aria-current="page">Thanh toán</li>
            </ol>
        </nav>
    </div>
</div>

<div class="container py-5">
    <h1 class="font-serif display-6 mb-4">Thông Tin Đặt Hàng</h1>

    @using (Html.BeginForm("Index", "Checkout", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

        <div class="row g-5">
            <!-- Left: Delivery Information Form -->
            <div class="col-lg-7">
                <div class="card border border-light-subtle rounded-0 bg-white p-4 shadow-none mb-4">
                    <h5 class="font-serif mb-4 pb-2 border-bottom">1. Thông Tin Người Nhận</h5>

                    <div class="mb-3">
                        @Html.LabelFor(m => m.ReceiverName, new { @class = "form-label small fw-semibold text-uppercase letter-spacing-1" })
                        @Html.TextBoxFor(m => m.ReceiverName, new { @class = "form-control", placeholder = "Nguyễn Văn A" })
                        @Html.ValidationMessageFor(m => m.ReceiverName, "", new { @class = "text-danger small" })
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            @Html.LabelFor(m => m.ReceiverPhone, new { @class = "form-label small fw-semibold text-uppercase letter-spacing-1" })
                            @Html.TextBoxFor(m => m.ReceiverPhone, new { @class = "form-control", placeholder = "0987654321" })
                            @Html.ValidationMessageFor(m => m.ReceiverPhone, "", new { @class = "text-danger small" })
                        </div>
                        <div class="col-md-6">
                            @Html.LabelFor(m => m.Email, new { @class = "form-label small fw-semibold text-uppercase letter-spacing-1" })
                            @Html.TextBoxFor(m => m.Email, new { @class = "form-control", placeholder = "email@example.com" })
                            @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small" })
                        </div>
                    </div>

                    <div class="mb-3">
                        @Html.LabelFor(m => m.ShippingAddress, new { @class = "form-label small fw-semibold text-uppercase letter-spacing-1" })
                        @Html.TextBoxFor(m => m.ShippingAddress, new { @class = "form-control", placeholder = "Số nhà, tên đường, phường/xã, quận/huyện, tỉnh/thành phố" })
                        @Html.ValidationMessageFor(m => m.ShippingAddress, "", new { @class = "text-danger small" })
                    </div>

                    <div class="mb-3">
                        @Html.LabelFor(m => m.Note, new { @class = "form-label small fw-semibold text-uppercase letter-spacing-1" })
                        @Html.TextAreaFor(m => m.Note, new { @class = "form-control", rows = "2", placeholder = "Ghi chú giao hàng (ví dụ: giao giờ hành chính, gọi trước khi đến...)" })
                    </div>
                </div>

                <div class="card border border-light-subtle rounded-0 bg-white p-4 shadow-none">
                    <h5 class="font-serif mb-4 pb-2 border-bottom">2. Phương Thức Thanh Toán</h5>

                    <div class="form-check p-3 border mb-2 rounded-1">
                        <input class="form-check-input ms-0 me-3" type="radio" name="PaymentMethod" id="paymentCod" value="COD" checked>
                        <label class="form-check-label fw-semibold" for="paymentCod">
                            <i class="bi bi-cash-stack me-2 text-gold"></i> Thanh toán khi nhận hàng (COD)
                        </label>
                        <div class="small text-muted ms-4 mt-1">Kiểm tra sản phẩm và thanh toán tiền mặt trực tiếp cho nhân viên giao hàng.</div>
                    </div>

                    <div class="form-check p-3 border rounded-1">
                        <input class="form-check-input ms-0 me-3" type="radio" name="PaymentMethod" id="paymentBank" value="BankTransfer">
                        <label class="form-check-label fw-semibold" for="paymentBank">
                            <i class="bi bi-bank me-2 text-gold"></i> Chuyển khoản ngân hàng (QR Code)
                        </label>
                        <div class="small text-muted ms-4 mt-1">Quét mã QR thanh toán qua ứng dụng ngân hàng hoặc ví điện tử.</div>
                    </div>
                </div>
            </div>

            <!-- Right: Order Items & Summary -->
            <div class="col-lg-5">
                <div class="card border border-light-subtle rounded-0 bg-white p-4 shadow-none position-sticky" style="top: 100px;">
                    <h5 class="font-serif mb-4 pb-2 border-bottom">Đơn Hàng (@Model.Cart.TotalItems sản phẩm)</h5>

                    <!-- Product Items List -->
                    <div class="mb-4" style="max-height: 280px; overflow-y: auto;">
                        @foreach (var item in Model.Cart.Items)
                        {
                            <div class="d-flex align-items-center justify-content-between py-2 border-bottom">
                                <div class="d-flex align-items-center gap-3">
                                    <img src="@(!string.IsNullOrEmpty(item.ImageUrl) ? item.ImageUrl : "/Content/images/placeholder-perfume.svg")" 
                                         alt="@item.ProductName" 
                                         style="width: 50px; height: 55px; object-fit: cover;" 
                                         class="border"
                                         onerror="this.src='/Content/images/placeholder-perfume.svg'" />
                                    <div>
                                        <div class="fw-semibold small text-truncate" style="max-width: 200px;">@item.ProductName</div>
                                        <div class="small text-muted">@(item.VolumeML)ml × @item.Quantity</div>
                                    </div>
                                </div>
                                <span class="fw-bold small">@item.SubTotal.ToString("N0") ₫</span>
                            </div>
                        }
                    </div>

                    <!-- Summary Calculations -->
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Tạm tính:</span>
                        <span class="fw-semibold">@Model.Cart.SubTotal.ToString("N0") ₫</span>
                    </div>

                    @if (Model.Cart.DiscountAmount > 0)
                    {
                        <div class="d-flex justify-content-between mb-2 text-danger">
                            <span>Giảm giá (@Model.Cart.CouponCode):</span>
                            <span>-@Model.Cart.DiscountAmount.ToString("N0") ₫</span>
                        </div>
                    }

                    <div class="d-flex justify-content-between mb-3 pb-3 border-bottom">
                        <span class="text-muted">Phí vận chuyển:</span>
                        <span>
                            @if (Model.Cart.ShippingFee == 0)
                            {
                                <span class="badge bg-success">Miễn phí</span>
                            }
                            else
                            {
                                <span>@Model.Cart.ShippingFee.ToString("N0") ₫</span>
                            }
                        </span>
                    </div>

                    <div class="d-flex justify-content-between align-items-baseline mb-4">
                        <span class="font-serif fs-5 fw-bold">Tổng thanh toán:</span>
                        <span class="display-6 fw-bold text-dark">@Model.Cart.TotalAmount.ToString("N0") ₫</span>
                    </div>

                    <button type="submit" class="btn btn-luxury-dark w-100 py-3 text-center">
                        Xác Nhận Đặt Hàng <i class="bi bi-check2-circle ms-2"></i>
                    </button>

                    <div class="mt-3 text-center">
                        <a href="@Url.Action("Index", "Cart")" class="small text-muted">
                            <i class="bi bi-chevron-left"></i> Quay lại giỏ hàng
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

