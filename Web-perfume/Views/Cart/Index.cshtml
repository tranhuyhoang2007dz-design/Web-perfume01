@model Web_perfume.Models.CartViewModel
@{
    ViewBag.Title = "Giỏ Hàng";
}

<!-- Breadcrumbs -->
<div class="bg-light py-3 border-bottom">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 small">
                <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Trang chủ</a></li>
                <li class="breadcrumb-item active" aria-current="page">Giỏ hàng (@Model.TotalItems sản phẩm)</li>
            </ol>
        </nav>
    </div>
</div>

<div class="container py-5">
    <h1 class="font-serif display-6 mb-4">Giỏ Hàng Của Bạn</h1>

    @if (Model.Items.Any())
    {
        <div class="row g-5">
            <!-- Left: Cart Items Table -->
            <div class="col-lg-8">
                <div class="table-responsive border border-light-subtle bg-white">
                    <table class="table align-middle mb-0">
                        <thead class="bg-light text-uppercase small letter-spacing-1">
                            <tr>
                                <th style="width: 45%;" class="ps-3 py-3">Sản phẩm</th>
                                <th style="width: 15%;" class="text-center py-3">Đơn giá</th>
                                <th style="width: 20%;" class="text-center py-3">Số lượng</th>
                                <th style="width: 15%;" class="text-end py-3">Tạm tính</th>
                                <th style="width: 5%;" class="pe-3 py-3"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td class="ps-3 py-3">
                                        <div class="d-flex align-items-center gap-3">
                                            <a href="@Url.Action("Detail", "Products", new { id = !string.IsNullOrEmpty(item.Slug) ? item.Slug : item.ProductID.ToString() })">
                                                <img src="@(!string.IsNullOrEmpty(item.ImageUrl) ? item.ImageUrl : "/Content/images/placeholder-perfume.svg")" 
                                                     alt="@item.ProductName" 
                                                     style="width: 70px; height: 75px; object-fit: cover;" 
                                                     class="border"
                                                     onerror="this.src='/Content/images/placeholder-perfume.svg'" />
                                            </a>
                                            <div>
                                                <span class="text-uppercase small text-gold fw-bold d-block">@item.BrandName</span>
                                                <a href="@Url.Action("Detail", "Products", new { id = !string.IsNullOrEmpty(item.Slug) ? item.Slug : item.ProductID.ToString() })" class="fw-semibold text-dark text-decoration-none">
                                                    @item.ProductName
                                                </a>
                                                <div class="small text-muted mt-1">
                                                    Dung tích: <strong>@(item.VolumeML)ml</strong> • SKU: @item.SKU
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="text-center py-3">
                                        <span class="fw-semibold">@item.UnitPrice.ToString("N0") ₫</span>
                                    </td>
                                    <td class="text-center py-3">
                                        <div class="quantity-control mx-auto">
                                            <button type="button" class="quantity-btn" onclick="updateItemQty(@item.VariantID, @(item.Quantity - 1))"><i class="bi bi-dash"></i></button>
                                            <input type="number" class="quantity-input" value="@item.Quantity" min="1" max="@item.StockQuantity" onchange="updateItemQty(@item.VariantID, this.value)" />
                                            <button type="button" class="quantity-btn" onclick="updateItemQty(@item.VariantID, @(item.Quantity + 1))"><i class="bi bi-plus"></i></button>
                                        </div>
                                    </td>
                                    <td class="text-end py-3">
                                        <span class="fw-bold text-dark">@item.SubTotal.ToString("N0") ₫</span>
                                    </td>
                                    <td class="pe-3 py-3 text-end">
                                        <form action="@Url.Action("RemoveItem", "Cart")" method="post" style="display:inline;">
                                            <input type="hidden" name="variantId" value="@item.VariantID" />
                                            <button type="submit" class="btn btn-link text-muted p-0" title="Xóa">
                                                <i class="bi bi-trash3"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="d-flex justify-content-between align-items-center mt-4">
                    <a href="@Url.Action("Index", "Products")" class="btn btn-luxury-outline">
                        <i class="bi bi-arrow-left me-2"></i> Tiếp tục mua sắm
                    </a>
                </div>
            </div>

            <!-- Right: Order Summary Card -->
            <div class="col-lg-4">
                <div class="card border border-light-subtle rounded-0 bg-white p-4 shadow-none">
                    <h5 class="font-serif mb-4 pb-2 border-bottom">Tóm Tắt Đơn Hàng</h5>

                    <!-- Coupon Form -->
                    <div class="mb-4">
                        <label class="small fw-semibold text-uppercase letter-spacing-1 mb-2">Mã giảm giá (Coupon):</label>
                        <form action="@Url.Action("ApplyCoupon", "Cart")" method="post" class="d-flex gap-2">
                            <input type="text" name="couponCode" class="form-control form-control-sm text-uppercase" placeholder="Nhập mã voucher..." value="@Model.CouponCode" />
                            <button type="submit" class="btn btn-luxury-dark py-1 px-3 small">Áp Dụng</button>
                        </form>
                        @if (TempData["CouponError"] != null)
                        {
                            <div class="text-danger small mt-1">@TempData["CouponError"]</div>
                        }
                        @if (TempData["CouponSuccess"] != null)
                        {
                            <div class="text-success small mt-1">@TempData["CouponSuccess"]</div>
                        }
                    </div>

                    <!-- Price Calculations -->
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Tạm tính:</span>
                        <span class="fw-semibold">@Model.SubTotal.ToString("N0") ₫</span>
                    </div>

                    @if (Model.DiscountAmount > 0)
                    {
                        <div class="d-flex justify-content-between mb-2 text-danger">
                            <span>Giảm giá (@Model.CouponCode):</span>
                            <span>-@Model.DiscountAmount.ToString("N0") ₫</span>
                        </div>
                    }

                    <div class="d-flex justify-content-between mb-3 pb-3 border-bottom">
                        <span class="text-muted">Phí vận chuyển:</span>
                        <span>
                            @if (Model.ShippingFee == 0)
                            {
                                <span class="badge bg-success">Miễn phí</span>
                            }
                            else
                            {
                                <span>@Model.ShippingFee.ToString("N0") ₫</span>
                            }
                        </span>
                    </div>

                    <div class="d-flex justify-content-between align-items-baseline gap-2 mb-4">
                        <span class="font-serif fs-6 fw-bold text-nowrap">Tổng thanh toán:</span>
                        <span class="fs-4 fw-bold text-dark text-nowrap">@Model.TotalAmount.ToString("N0") ₫</span>
                    </div>

                    <a href="@Url.Action("Index", "Checkout")" class="btn btn-luxury-dark w-100 py-3 text-center">
                        Tiến Hành Đặt Hàng <i class="bi bi-arrow-right ms-2"></i>
                    </a>

                    <div class="mt-4 pt-3 border-top small text-muted text-center">
                        <i class="bi bi-shield-lock me-1"></i> Thanh toán bảo mật an toàn 100%
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- Empty Cart -->
        <div class="text-center py-5 my-5 bg-white border border-light-subtle">
            <div class="display-1 text-muted mb-3"><i class="bi bi-bag-x"></i></div>
            <h2 class="font-serif h3 mb-2">Giỏ hàng của bạn đang trống</h2>
            <p class="text-muted mb-4">Hãy khám phá bộ sưu tập những mùi hương đẳng cấp để tìm kiếm nốt hương hoàn hảo cho bạn.</p>
            <a href="@Url.Action("Index", "Products")" class="btn btn-luxury-dark px-4 py-3">
                Khám Phá Nước Hoa Ngay <i class="bi bi-arrow-right ms-2"></i>
            </a>
        </div>
    }
</div>

@section scripts {
    <script>
        function updateItemQty(variantId, newQty) {
            if (newQty < 1) newQty = 0;
            $.post('@Url.Action("UpdateQuantity", "Cart")', { variantId: variantId, quantity: newQty }, function (res) {
                if (res && res.success) {
                    location.reload();
                } else {
                    showToast(res ? res.message : 'Lỗi cập nhật giỏ hàng', 'error');
                }
            });
        }
    </script>
}

