@model Web_perfume.Models.Product
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewBag.Title = "Thêm Nước Hoa Mới";
}

<div class="row justify-content-center">
    <div class="col-lg-10">
        <div class="card border border-light-subtle rounded-0 bg-white p-4 p-md-5 shadow-none">
            <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
                <h5 class="font-serif mb-0">Thêm Nước Hoa Mới Vào Kho</h5>
                <a href="@Url.Action("Products", "Admin")" class="small text-muted">
                    <i class="bi bi-arrow-left"></i> Quay lại danh sách
                </a>
            </div>

            @using (Html.BeginForm("CreateProduct", "Admin", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "alert alert-danger small" })

                <div class="row g-4">
                    <!-- Basic Information -->
                    <div class="col-md-12">
                        <h6 class="text-uppercase small fw-bold text-gold letter-spacing-1 mb-3">1. Thông tin cơ bản</h6>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label small fw-semibold text-uppercase">Tên nước hoa:</label>
                        <input type="text" name="ProductName" class="form-control" placeholder="Ví dụ: Dior Sauvage Eau De Parfum" required />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label small fw-semibold text-uppercase">Thương hiệu:</label>
                        @Html.DropDownList("BrandID", null, new { @class = "form-select" })
                    </div>

                    <div class="col-md-3">
                        <label class="form-label small fw-semibold text-uppercase">Danh mục:</label>
                        @Html.DropDownList("CategoryID", null, new { @class = "form-select" })
                    </div>

                    <div class="col-md-4">
                        <label class="form-label small fw-semibold text-uppercase">Giới tính:</label>
                        <select name="Gender" class="form-select">
                            <option value="Men">Nam</option>
                            <option value="Women">Nữ</option>
                            <option value="Unisex">Unisex</option>
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label small fw-semibold text-uppercase">Nồng độ hương:</label>
                        <select name="Concentration" class="form-select">
                            <option value="EDP">EDP (Eau De Parfum)</option>
                            <option value="EDT">EDT (Eau De Toilette)</option>
                            <option value="Parfum">Parfum</option>
                            <option value="Extrait">Extrait De Parfum</option>
                            <option value="Cologne">Eau De Cologne</option>
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label small fw-semibold text-uppercase">Hình ảnh (URL):</label>
                        <input type="text" name="imageUrl" class="form-control" placeholder="/images/products/ten-san-pham.jpg" />
                    </div>

                    <div class="col-12">
                        <label class="form-label small fw-semibold text-uppercase">Mô tả sản phẩm & Tầng hương:</label>
                        <textarea name="Description" class="form-control" rows="4" placeholder="Mô tả phong cách, nốt hương đầu, hương giữa, hương cuối..."></textarea>
                    </div>

                    <!-- Variant Details -->
                    <div class="col-md-12 pt-3 border-top">
                        <h6 class="text-uppercase small fw-bold text-gold letter-spacing-1 mb-3">2. Dung tích & Giá bán ban đầu</h6>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label small fw-semibold text-uppercase">Dung tích (ml):</label>
                        <input type="number" name="volumeML" class="form-control" value="100" required />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label small fw-semibold text-uppercase">Giá gốc (VNĐ):</label>
                        <input type="number" name="price" class="form-control" value="2500000" step="10000" required />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label small fw-semibold text-uppercase">Giá khuyến mãi (VNĐ):</label>
                        <input type="number" name="salePrice" class="form-control" placeholder="Để trống nếu không giảm" step="10000" />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label small fw-semibold text-uppercase">Tồn kho ban đầu:</label>
                        <input type="number" name="stockQuantity" class="form-control" value="20" required />
                    </div>

                    <!-- Status Settings -->
                    <div class="col-12 pt-3 border-top">
                        <div class="form-check form-check-inline me-4">
                            <input class="form-check-input" type="checkbox" name="IsFeatured" value="true" id="checkFeatured">
                            <label class="form-check-label small fw-semibold" for="checkFeatured">Đánh dấu Nổi Bật (Hiển thị trang chủ)</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" name="IsActive" value="true" id="checkActive" checked>
                            <label class="form-check-label small fw-semibold" for="checkActive">Kích hoạt bán ngay</label>
                        </div>
                    </div>

                    <div class="col-12 mt-4">
                        <button type="submit" class="btn btn-luxury-dark px-4 py-3">
                            <i class="bi bi-check2-circle me-1"></i> Lưu Nước Hoa Vào Kho
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

