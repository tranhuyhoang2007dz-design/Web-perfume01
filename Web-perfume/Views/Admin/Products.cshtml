@model List<Web_perfume.Models.Product>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewBag.Title = "Quản Lý Nước Hoa";
}

<div class="card border border-light-subtle rounded-0 bg-white p-4 shadow-none">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h5 class="font-serif mb-1">Danh Sách Sản Phẩm (@Model.Count)</h5>
            <span class="text-muted small">Quản lý kho hàng, thương hiệu và thông tin nước hoa</span>
        </div>
        <a href="@Url.Action("CreateProduct", "Admin")" class="btn btn-luxury-dark py-2 px-3 small">
            <i class="bi bi-plus-lg me-1"></i> Thêm Nước Hoa
        </a>
    </div>

    <div class="table-responsive">
        <table class="table align-middle small table-hover mb-0">
            <thead class="bg-light text-uppercase">
                <tr>
                    <th style="width: 5%;">ID</th>
                    <th style="width: 10%;">Ảnh</th>
                    <th style="width: 30%;">Tên nước hoa</th>
                    <th style="width: 15%;">Thương hiệu</th>
                    <th style="width: 10%;">Giới tính</th>
                    <th style="width: 10%;">Nồng độ</th>
                    <th style="width: 10%;">Trạng thái</th>
                    <th style="width: 10%;" class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    var primaryImg = p.ProductImages.FirstOrDefault(i => i.IsPrimary)?.ImageURL 
                                     ?? p.ProductImages.FirstOrDefault()?.ImageURL 
                                     ?? "/Content/images/placeholder-perfume.svg";
                    <tr>
                        <td><strong>#@p.ProductID</strong></td>
                        <td>
                            <img src="@primaryImg" 
                                 alt="@p.ProductName" 
                                 style="width: 45px; height: 50px; object-fit: cover;" 
                                 class="border"
                                 onerror="this.src='/Content/images/placeholder-perfume.svg'" />
                        </td>
                        <td>
                            <div class="fw-bold text-dark">@p.ProductName</div>
                            <div class="text-muted small">@p.Category.CategoryName • @p.ProductVariants.Count dung tích</div>
                        </td>
                        <td>
                            <span class="badge bg-light text-dark border">@p.Brand.BrandName</span>
                        </td>
                        <td>@p.Gender</td>
                        <td>@p.Concentration</td>
                        <td>
                            @if (p.IsActive)
                            {
                                <span class="badge bg-success">Đang bán</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Tạm ẩn</span>
                            }
                        </td>
                        <td class="text-end">
                            <div class="btn-group btn-group-sm">
                                <a href="@Url.Action("EditProduct", "Admin", new { id = p.ProductID })" class="btn btn-outline-secondary" title="Sửa">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <button type="button" class="btn btn-outline-secondary" onclick="toggleProductActive(@p.ProductID)" title="Ẩn/Hiện">
                                    <i class="bi bi-eye"></i>
                                </button>
                                <a href="@Url.Action("Detail", "Products", new { id = !string.IsNullOrEmpty(p.Slug) ? p.Slug : p.ProductID.ToString() })" target="_blank" class="btn btn-outline-secondary" title="Xem trên web">
                                    <i class="bi bi-box-arrow-up-right"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section scripts {
    <script>
        function toggleProductActive(id) {
            if (confirm('Bạn có chắc muốn thay đổi trạng thái hiển thị của sản phẩm này?')) {
                $.post('@Url.Action("DeleteProduct", "Admin")', { id: id }, function (res) {
                    if (res && res.success) {
                        location.reload();
                    } else {
                        alert('Không thể thực hiện thao tác.');
                    }
                });
            }
        }
    </script>
}

