@model List<Web_perfume.Models.Brand>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewBag.Title = "Quản Lý Thương Hiệu";
}

<div class="row g-4">
    <!-- Add Brand Card -->
    <div class="col-lg-4">
        <div class="card border border-light-subtle rounded-0 bg-white p-4 shadow-none">
            <h5 class="font-serif mb-3 pb-2 border-bottom">Thêm Thương Hiệu Mới</h5>

            @using (Html.BeginForm("CreateBrand", "Admin", FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label class="form-label small fw-semibold text-uppercase">Tên thương hiệu:</label>
                    <input type="text" name="BrandName" class="form-control" placeholder="Ví dụ: Tom Ford, Versace" required />
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-semibold text-uppercase">Quốc gia xuất xứ:</label>
                    <input type="text" name="Country" class="form-control" placeholder="Ví dụ: Pháp, Ý, Mỹ" />
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-semibold text-uppercase">Mô tả tóm tắt:</label>
                    <textarea name="Description" class="form-control" rows="3" placeholder="Giới thiệu thương hiệu..."></textarea>
                </div>

                <button type="submit" class="btn btn-luxury-dark w-100 py-2">
                    <i class="bi bi-plus-circle me-1"></i> Lưu Thương Hiệu
                </button>
            }
        </div>
    </div>

    <!-- Brands Table -->
    <div class="col-lg-8">
        <div class="card border border-light-subtle rounded-0 bg-white p-4 shadow-none">
            <h5 class="font-serif mb-3 pb-2 border-bottom">Danh Sách Thương Hiệu Hiện Có (@Model.Count)</h5>

            <div class="table-responsive">
                <table class="table align-middle small mb-0 table-hover">
                    <thead class="bg-light text-uppercase">
                        <tr>
                            <th>ID</th>
                            <th>Thương hiệu</th>
                            <th>Quốc gia</th>
                            <th>Số nước hoa</th>
                            <th>Trạng thái</th>
                            <th class="text-end">Xem</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var b in Model)
                        {
                            <tr>
                                <td>#@b.BrandID</td>
                                <td><strong>@b.BrandName</strong></td>
                                <td>@(string.IsNullOrEmpty(b.Country) ? "N/A" : b.Country)</td>
                                <td><span class="badge bg-light text-dark border">@b.Products.Count chai</span></td>
                                <td>
                                    @if (b.IsActive)
                                    {
                                        <span class="badge bg-success">Hoạt động</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Tạm ẩn</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <a href="@Url.Action("Detail", "Brands", new { id = b.BrandID })" target="_blank" class="btn btn-sm btn-outline-secondary">
                                        <i class="bi bi-box-arrow-up-right"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

