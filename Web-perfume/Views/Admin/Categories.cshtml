@model List<Web_perfume.Models.Category>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewBag.Title = "Quản Lý Danh Mục";
}

<div class="row g-4">
    <!-- Add Category Card -->
    <div class="col-lg-4">
        <div class="card border border-light-subtle rounded-0 bg-white p-4 shadow-none">
            <h5 class="font-serif mb-3 pb-2 border-bottom">Thêm Danh Mục Mới</h5>

            @using (Html.BeginForm("CreateCategory", "Admin", FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label class="form-label small fw-semibold text-uppercase">Tên danh mục:</label>
                    <input type="text" name="CategoryName" class="form-control" placeholder="Ví dụ: Nước hoa Niche, Mini" required />
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-semibold text-uppercase">Mô tả:</label>
                    <textarea name="Description" class="form-control" rows="3" placeholder="Mô tả nhóm sản phẩm..."></textarea>
                </div>

                <button type="submit" class="btn btn-luxury-dark w-100 py-2">
                    <i class="bi bi-plus-circle me-1"></i> Lưu Danh Mục
                </button>
            }
        </div>
    </div>

    <!-- Categories Table -->
    <div class="col-lg-8">
        <div class="card border border-light-subtle rounded-0 bg-white p-4 shadow-none">
            <h5 class="font-serif mb-3 pb-2 border-bottom">Danh Mục Nước Hoa (@Model.Count)</h5>

            <div class="table-responsive">
                <table class="table align-middle small mb-0 table-hover">
                    <thead class="bg-light text-uppercase">
                        <tr>
                            <th style="width: 7%;">ID</th>
                            <th style="width: 25%;">Tên danh mục</th>
                            <th style="width: 20%;">Slug</th>
                            <th style="width: 18%;">Số sản phẩm</th>
                            <th style="width: 13%;">Trạng thái</th>
                            <th style="width: 17%;" class="text-end">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in Model)
                        {
                            <tr>
                                <td>#@c.CategoryID</td>
                                <td><strong>@c.CategoryName</strong></td>
                                <td><code>@c.Slug</code></td>
                                <td><span class="badge bg-light text-dark border">@c.Products.Count sản phẩm</span></td>
                                <td>
                                    @if (c.IsActive)
                                    {
                                        <span class="badge bg-success">Hoạt động</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Tạm ẩn</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <button type="button" class="btn btn-outline-secondary btn-edit-category"
                                                title="Sửa"
                                                data-id="@c.CategoryID"
                                                data-name="@c.CategoryName"
                                                data-description="@c.Description"
                                                data-active="@(c.IsActive ? "true" : "false")">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <button type="button" class="btn btn-outline-secondary btn-view-category"
                                                title="Xem sản phẩm trong danh mục"
                                                data-id="@c.CategoryID"
                                                data-name="@c.CategoryName">
                                            <i class="bi bi-box-arrow-up-right"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- ============ MODAL: SỬA DANH MỤC ============ -->
<div class="modal fade" id="editCategoryModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-0 border">
            @using (Html.BeginForm("EditCategory", "Admin", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" name="CategoryID" id="editCategoryId" />

                <div class="modal-header">
                    <h5 class="modal-title font-serif">Chỉnh Sửa Danh Mục</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" data-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-uppercase">Tên danh mục:</label>
                        <input type="text" name="CategoryName" id="editCategoryName" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-uppercase">Mô tả:</label>
                        <textarea name="Description" id="editCategoryDescription" class="form-control" rows="3"></textarea>
                    </div>
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="editCategoryActive" name="IsActive" value="true" />
                        <label class="form-check-label small" for="editCategoryActive">Đang hoạt động</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal" data-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-luxury-dark px-4">
                        <i class="bi bi-check-lg me-1"></i> Cập Nhật
                    </button>
                </div>
            }
        </div>
    </div>
</div>

<!-- ============ MODAL: XEM SẢN PHẨM TRONG DANH MỤC ============ -->
<div class="modal fade" id="viewCategoryModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content rounded-0 border">
            <div class="modal-header">
                <div>
                    <h5 class="modal-title font-serif mb-0" id="viewCategoryTitle">Danh mục</h5>
                    <span class="text-muted small" id="viewCategoryCount"></span>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" data-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-0">
                <div id="viewCategoryLoading" class="text-center text-muted small py-5">Đang tải...</div>
                <div class="table-responsive">
                    <table class="table align-middle small table-hover mb-0" id="viewCategoryTable" style="display:none;">
                        <thead class="bg-light text-uppercase">
                            <tr>
                                <th style="width: 10%;">Ảnh</th>
                                <th style="width: 40%;">Tên nước hoa</th>
                                <th style="width: 20%;">Thương hiệu</th>
                                <th style="width: 15%;">Giới tính</th>
                                <th style="width: 15%;">Trạng thái</th>
                            </tr>
                        </thead>
                        <tbody id="viewCategoryBody"></tbody>
                    </table>
                </div>
                <div id="viewCategoryEmpty" class="text-center text-muted small py-5" style="display:none;">
                    Danh mục này chưa có sản phẩm nào.
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal" data-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
        // Hỗ trợ cả Bootstrap 5 (không cần jQuery) và Bootstrap 3/4 (jQuery)
        function showModal(id) {
            var el = document.getElementById(id);
            if (window.bootstrap && bootstrap.Modal) {
                bootstrap.Modal.getOrCreateInstance(el).show();
            } else {
                $('#' + id).modal('show');
            }
        }

        function escapeHtml(s) {
            return String(s == null ? '' : s)
                .replace(/&/g, '&amp;').replace(/</g, '&lt;')
                .replace(/>/g, '&gt;').replace(/"/g, '&quot;');
        }

        // ---------- Sửa danh mục ----------
        $(document).on('click', '.btn-edit-category', function () {
            var b = $(this);
            $('#editCategoryId').val(b.data('id'));
            $('#editCategoryName').val(b.data('name'));
            $('#editCategoryDescription').val(b.data('description'));
            $('#editCategoryActive').prop('checked', String(b.data('active')) === 'true');
            showModal('editCategoryModal');
        });

        // ---------- Xem sản phẩm trong danh mục ----------
        $(document).on('click', '.btn-view-category', function () {
            var id = $(this).data('id');
            var name = $(this).data('name');

            $('#viewCategoryTitle').text('Danh mục: ' + name);
            $('#viewCategoryCount').text('');
            $('#viewCategoryBody').empty();
            $('#viewCategoryTable, #viewCategoryEmpty').hide();
            $('#viewCategoryLoading').show();
            showModal('viewCategoryModal');

            $.get('@Url.Action("GetCategoryProducts", "Admin")', { id: id }, function (res) {
                $('#viewCategoryLoading').hide();
                if (!res || !res.success) {
                    $('#viewCategoryEmpty').text('Không thể tải dữ liệu.').show();
                    return;
                }
                if (res.products.length === 0) {
                    $('#viewCategoryEmpty').text('Danh mục này chưa có sản phẩm nào.').show();
                    return;
                }

                $('#viewCategoryCount').text(res.products.length + ' sản phẩm');
                var rows = '';
                $.each(res.products, function (i, p) {
                    rows += '<tr>' +
                        '<td><img src="' + escapeHtml(p.image) + '" alt="" class="border" ' +
                            'style="width:45px;height:50px;object-fit:cover;" ' +
                            'onerror="this.src=\'/Content/images/placeholder-perfume.svg\'" /></td>' +
                        '<td><div class="fw-bold text-dark">' + escapeHtml(p.name) + '</div>' +
                            '<div class="text-muted small">#' + p.id + '</div></td>' +
                        '<td><span class="badge bg-light text-dark border">' + escapeHtml(p.brand) + '</span></td>' +
                        '<td>' + escapeHtml(p.gender) + '</td>' +
                        '<td>' + (p.isActive
                            ? '<span class="badge bg-success">Đang bán</span>'
                            : '<span class="badge bg-secondary">Tạm ẩn</span>') + '</td>' +
                        '</tr>';
                });
                $('#viewCategoryBody').html(rows);
                $('#viewCategoryTable').show();
            }).fail(function () {
                $('#viewCategoryLoading').hide();
                $('#viewCategoryEmpty').text('Không thể tải dữ liệu.').show();
            });
        });
    </script>
}