@model List<Web_perfume.Models.ProductItemViewModel>
@{
    var brand = ViewBag.Brand as Web_perfume.Models.Brand;
    ViewBag.Title = brand != null ? brand.BrandName : "Thương Hiệu";
}

<!-- Breadcrumbs -->
<div class="bg-light py-3 border-bottom">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 small">
                <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Trang chủ</a></li>
                <li class="breadcrumb-item"><a href="@Url.Action("Index", "Brands")">Thương hiệu</a></li>
                <li class="breadcrumb-item active" aria-current="page">@(brand != null ? brand.BrandName : "")</li>
            </ol>
        </nav>
    </div>
</div>

<div class="container py-5">
    @if (brand != null)
    {
        <!-- Brand Header Banner -->
        <div class="p-5 mb-5 bg-white border border-light-subtle text-center">
            <span class="badge bg-light text-gold border text-uppercase mb-2">@(string.IsNullOrEmpty(brand.Country) ? "Pháp" : brand.Country)</span>
            <h1 class="font-serif display-5 mb-3">@brand.BrandName</h1>
            <p class="text-secondary max-w-700 mx-auto mb-0" style="max-width: 650px;">
                @(string.IsNullOrEmpty(brand.Description) 
                  ? "Khám phá trọn bộ các dòng nước hoa quyến rũ và ấn tượng từ thương hiệu " + brand.BrandName + ", được phân phối chính hãng kèm cam kết chất lượng 100%."
                  : brand.Description)
            </p>
        </div>

        <!-- Products Grid -->
        <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
            <h4 class="font-serif mb-0">Tất cả sản phẩm (@Model.Count)</h4>
            <a href="@Url.Action("Index", "Products", new { brandId = brand.BrandID })" class="small text-muted">
                Lọc nâng cao <i class="bi bi-filter"></i>
            </a>
        </div>

        if (Model.Any())
        {
            <div class="row g-4">
                @foreach (var prod in Model)
                {
                    <div class="col-xl-3 col-lg-4 col-md-6">
                        @Html.Partial("_ProductCard", prod)
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-5 bg-white border">
                <p class="text-muted mb-0">Chưa có sản phẩm nào thuộc thương hiệu này.</p>
            </div>
        }
    }
</div>

